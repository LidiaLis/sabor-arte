<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,java.util.Collections" %>
<%@ page import="br.com.saborearte.dao.RelatorioDAO.UsuarioRelatorio" %>
<%@ page import="br.com.saborearte.dao.RelatorioDAO.CategoriaRelatorio" %>
<%@ page import="br.com.saborearte.dao.FluxoDAO.FluxoRelatorio" %>
<%!
private String h(Object v){if(v==null)return "";return String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String label(Object v){if(v==null)return "";String s=String.valueOf(v).toLowerCase().replace('_',' ');return s.isEmpty()?s:Character.toUpperCase(s.charAt(0))+s.substring(1);}
%>
<%
request.setAttribute("currentPage","relatorios");String ctx=request.getContextPath();
String tipo=request.getAttribute("tipoRelatorio")==null?"usuarios":String.valueOf(request.getAttribute("tipoRelatorio"));
String status=request.getAttribute("statusFiltro")==null?"":String.valueOf(request.getAttribute("statusFiltro"));
String statusFluxo=request.getAttribute("statusFluxoFiltro")==null?"":String.valueOf(request.getAttribute("statusFluxoFiltro"));
Object dataInicio=request.getAttribute("dataInicio"),dataFim=request.getAttribute("dataFim");
List<UsuarioRelatorio> usuarios=(List<UsuarioRelatorio>)request.getAttribute("usuarios");if(usuarios==null)usuarios=Collections.emptyList();
List<CategoriaRelatorio> categorias=(List<CategoriaRelatorio>)request.getAttribute("categorias");if(categorias==null)categorias=Collections.emptyList();
List<FluxoRelatorio> fluxos=(List<FluxoRelatorio>)request.getAttribute("fluxos");if(fluxos==null)fluxos=Collections.emptyList();
int total="usuarios".equals(tipo)?usuarios.size():"categorias".equals(tipo)?categorias.size():fluxos.size();
%>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sabor &amp; Arte — Relatórios Administrativos</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;family=Nunito:wght@700;800&amp;family=Playfair+Display:ital,wght@0,600;1,600&amp;display=swap" rel="stylesheet"><script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{--moss:#4a5e3a;--cream:#f3efe6;--cream-dark:#e5dccb;--warm:#fffdf8;--text:#293022;--mid:#596052;--light:#899080;--danger:#a64b47}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--text);font-family:'DM Sans',sans-serif}.main{margin-left:240px;min-height:100vh}.content{max-width:1260px;margin:auto;padding:32px}.top{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:26px}.title{font:600 30px 'Playfair Display',serif}.subtitle{font-size:13px;color:var(--light);margin-top:5px}.buttons{display:flex;gap:7px}.btn{border:1px solid var(--cream-dark);background:var(--warm);padding:9px 13px;cursor:pointer;color:var(--mid);font:500 12px 'DM Sans',sans-serif}.layout{display:grid;grid-template-columns:240px 1fr;gap:18px}.panel,.result{background:var(--warm);border:1px solid var(--cream-dark)}.head{padding:15px 17px;border-bottom:1px solid var(--cream-dark);font-weight:600}.types a{display:block;padding:12px 16px;color:var(--mid);text-decoration:none;border-bottom:1px solid var(--cream-dark)}.types a.active{background:#eef2e9;color:var(--moss);border-left:3px solid var(--moss)}.filter{padding:16px}.filter label{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.8px;color:var(--light);font-weight:700;margin-bottom:6px}.filter select,.filter input{width:100%;padding:10px;border:1px solid var(--cream-dark);background:white;margin-bottom:10px}.filter .btn{width:100%;background:var(--moss);color:white}.result-head{display:flex;justify-content:space-between}.badge{background:var(--cream);color:var(--moss);padding:3px 8px;border-radius:12px;font-size:11px}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:12px}th{padding:10px 13px;background:var(--cream);color:var(--light);font-size:9px;text-transform:uppercase;letter-spacing:.8px;text-align:left}td{padding:12px 13px;border-top:1px solid var(--cream-dark);color:var(--mid)}.pill{display:inline-block;padding:4px 8px;border-radius:12px;background:#edf2e8;color:var(--moss);font-size:10px}.pill.inativo,.pill.inativa,.pill.rejeitado{background:#fae9e7;color:var(--danger)}.pill.pendente,.pill.em.revisao{background:#fff1dc;color:#9a651e}.empty{text-align:center;padding:55px!important;color:var(--light)}.pagination{display:flex;align-items:center;justify-content:space-between;padding:13px 17px;border-top:1px solid var(--cream-dark)}.pag-info{font-size:12px;color:var(--light)}.pag-btns{display:flex;gap:4px}.pag-btn{min-width:30px;height:30px;padding:0 8px;border:1px solid var(--cream-dark);background:var(--warm);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:12px;cursor:pointer;color:var(--mid);font-family:'DM Sans',sans-serif;font-weight:600;transition:all .15s}.pag-btn:hover:not(:disabled){border-color:var(--moss);color:var(--moss)}.pag-btn.active{background:var(--moss);border-color:var(--moss);color:#fff}.pag-btn:disabled{opacity:.4;cursor:not-allowed}.alert{padding:12px;margin-bottom:15px;background:#fae9e7;color:var(--danger)}#printArea{display:none}@media(max-width:900px){.main{margin-left:0}.layout{grid-template-columns:1fr}.content{padding:20px}.top{align-items:flex-start;flex-direction:column}}@media print{body>*:not(#printArea){display:none!important}#printArea{display:block!important}.print-table{border-collapse:collapse;width:100%;font-size:10px}.print-table td,.print-table th{border:1px solid #bbb;padding:6px}.print-table th{background:#34452a;color:white}.print-title{font:600 20px Georgia;margin-bottom:5px}.print-meta{font-size:10px;margin-bottom:12px}}
</style></head><body><jsp:include page="/pages/includes/sidebar.jsp" /><main class="main"><div class="content"><div class="top"><div><div class="title">Relatórios</div><div class="subtitle">Análises administrativas do blog</div></div><div class="buttons"><button class="btn" onclick="exportPDF()">⬇ PDF</button><button class="btn" onclick="exportExcel()">⬇ Excel</button><button class="btn" onclick="printReport()">🖨 Imprimir</button></div></div>
<%if(request.getAttribute("erro")!=null){%><div class="alert"><%=h(request.getAttribute("erro"))%></div><%}%>
<div class="layout"><aside><div class="panel"><div class="head">Relatórios</div><nav class="types"><a class="<%="usuarios".equals(tipo)?"active":""%>" href="<%=ctx%>/relatorio-admin?tipo=usuarios">👤 Usuários do Blog</a><a class="<%="categorias".equals(tipo)?"active":""%>" href="<%=ctx%>/relatorio-admin?tipo=categorias">🏷️ Receitas por Categoria</a><a class="<%="fluxo".equals(tipo)?"active":""%>" href="<%=ctx%>/relatorio-admin?tipo=fluxo"></a></nav></div><div class="panel" style="margin-top:14px"><div class="head">Filtros</div><form class="filter" method="get" action="<%=ctx%>/relatorio-admin"><input type="hidden" name="tipo" value="<%=h(tipo)%>"><%if("fluxo".equals(tipo)){%><label for="statusFluxo">Status de destino</label><select id="statusFluxo" name="statusFluxo"><option value="">Todos</option><option value="PENDENTE" <%="PENDENTE".equals(statusFluxo)?"selected":""%>>Pendente</option><option value="EM_REVISAO" <%="EM_REVISAO".equals(statusFluxo)?"selected":""%>>Em revisão</option><option value="APROVADO" <%="APROVADO".equals(statusFluxo)?"selected":""%>>Aprovado</option><option value="REJEITADO" <%="REJEITADO".equals(statusFluxo)?"selected":""%>>Rejeitado</option></select><label for="dataInicio">Data inicial</label><input type="date" id="dataInicio" name="dataInicio" value="<%=h(dataInicio)%>"><label for="dataFim">Data final</label><input type="date" id="dataFim" name="dataFim" value="<%=h(dataFim)%>"><%}else{%><label for="status">Status</label><select id="status" name="status"><option value="">Todos</option><%if("usuarios".equals(tipo)){%><option value="ATIVO" <%="ATIVO".equals(status)?"selected":""%>>Ativo</option><option value="INATIVO" <%="INATIVO".equals(status)?"selected":""%>>Inativo</option><%}else{%><option value="ATIVA" <%="ATIVA".equals(status)?"selected":""%>>Ativa</option><option value="INATIVA" <%="INATIVA".equals(status)?"selected":""%>>Inativa</option><%}%></select><%}%><button class="btn" type="submit">Gerar visualização</button></form></div></aside>
<section class="result"><div class="head result-head"><span><%="usuarios".equals(tipo)?"👤 Usuários do Blog":"categorias".equals(tipo)?"🏷️ Receitas por Categoria":"⚙️ Fluxo Editorial"%></span><span class="badge"><%=total%></span></div><div class="table-wrap"><table id="report-table"><thead><%if("usuarios".equals(tipo)){%><tr><th>Nome</th><th>E-mail</th><th>Tipo</th><th>Receitas</th><th>Publicadas</th><th>Visualizações</th><th>Status</th></tr><%}else if("categorias".equals(tipo)){%><tr><th>Categoria</th><th>Receitas</th><th>Status</th></tr><%}else{%><tr><th>Receita</th><th>Ação</th><th>Responsável</th><th>De</th><th>Para</th><th>Data</th></tr><%}%></thead><tbody>
<%if(total==0){%><tr><td class="empty" colspan="7">Nenhum registro encontrado.</td></tr><%}else if("usuarios".equals(tipo)){for(UsuarioRelatorio u:usuarios){%><tr><td><strong><%=h(u.nome)%></strong></td><td><%=h(u.email)%></td><td><%=h(label(u.tipo))%></td><td><%=u.receitas%></td><td><%=u.publicadas%></td><td><%=u.visualizacoes%></td><td><span class="pill <%=h(u.status.toLowerCase())%>"><%=h(label(u.status))%></span></td></tr><%}}else if("categorias".equals(tipo)){for(CategoriaRelatorio c:categorias){%><tr><td><%=h(c.emoji)%> <strong><%=h(c.nome)%></strong></td><td><%=c.totalReceitas%></td><td><span class="pill <%=h(c.status.toLowerCase())%>"><%=h(label(c.status))%></span></td></tr><%}}else{for(FluxoRelatorio f:fluxos){String acao="APROVADO".equals(f.statusPara)?"Aprovação":"REJEITADO".equals(f.statusPara)?"Rejeição":"EM_REVISAO".equals(f.statusPara)?"Correção/Revisão":"Envio para revisão";%><tr><td><strong><%=h(f.tituloReceita)%></strong></td><td><%=h(acao)%></td><td><%=h(f.responsavel)%></td><td><span class="pill"><%=h(f.statusDe==null?"Inicial":label(f.statusDe))%></span></td><td><span class="pill <%=h(f.statusPara.toLowerCase().replace('_',' '))%>"><%=h(label(f.statusPara))%></span></td><td><%=h(f.dataFluxo)%></td></tr><%}}%>
</tbody></table></div><div class="pagination" id="pagination"><div class="pag-info" id="pagInfo">—</div><div class="pag-btns" id="pagBtns"></div></div></section></div></div></main><div id="printArea"></div>
<script>
/* ── Paginação client-side (mesmo padrão de usuarios.jsp) ── */
var PAGE_SIZE = 8;
var paginaAtual = 1;
function linhasRelatorio(){return Array.from(document.querySelectorAll('#report-table tbody tr')).filter(function(r){return !r.querySelector('.empty');});}
function renderPaginaRelatorio(){
  var linhas=linhasRelatorio(),totalPaginas=Math.max(1,Math.ceil(linhas.length/PAGE_SIZE));
  if(paginaAtual>totalPaginas)paginaAtual=totalPaginas;
  if(paginaAtual<1)paginaAtual=1;
  linhas.forEach(function(row){row.style.display='none';});
  var inicio=(paginaAtual-1)*PAGE_SIZE,fim=inicio+PAGE_SIZE;
  linhas.slice(inicio,fim).forEach(function(row){row.style.display='';});
  renderPagInfo(linhas.length,inicio,fim);
  renderPagBtns(totalPaginas);
}
function renderPagInfo(total,inicio,fim){
  var info=document.getElementById('pagInfo');if(!info)return;
  if(total===0){info.textContent='Nenhum registro encontrado';return;}
  info.textContent='Mostrando '+(inicio+1)+'–'+Math.min(fim,total)+' de '+total;
}
function renderPagBtns(totalPaginas){
  var wrap=document.getElementById('pagBtns');if(!wrap)return;wrap.innerHTML='';
  function criarBtn(label,page,opts){opts=opts||{};var b=document.createElement('button');b.type='button';b.className='pag-btn'+(opts.active?' active':'');b.textContent=label;if(opts.disabled)b.disabled=true;b.addEventListener('click',function(){paginaAtual=page;renderPaginaRelatorio();});wrap.appendChild(b);}
  criarBtn('‹',paginaAtual-1,{disabled:paginaAtual===1});
  for(var p=1;p<=totalPaginas;p++){criarBtn(String(p),p,{active:p===paginaAtual});}
  criarBtn('›',paginaAtual+1,{disabled:paginaAtual===totalPaginas});
}
document.addEventListener('DOMContentLoaded',renderPaginaRelatorio);
function tableData(){var table=document.getElementById('report-table'),head=Array.from(table.tHead.rows[0].cells).map(function(c){return c.textContent.trim();}),rows=Array.from(table.tBodies[0].rows).filter(function(r){return !r.querySelector('.empty');}).map(function(r){return Array.from(r.cells).map(function(c){return c.textContent.trim();});});return{head:head,rows:rows};}
function requireData(){var d=tableData();if(!d.rows.length){alert('Nenhum registro para exportar.');return null;}return d;}
function exportPDF(){var d=requireData();if(!d)return;var doc=new window.jspdf.jsPDF({orientation:'landscape'});doc.text('Sabor & Arte — Relatórios',14,16);doc.autoTable({head:[d.head],body:d.rows,startY:23,theme:'grid',styles:{fontSize:8},headStyles:{fillColor:[52,69,42]}});doc.save('SaborArte_relatorio_<%=h(tipo)%>_'+Date.now()+'.pdf');}
function exportExcel(){var d=requireData();if(!d)return;var ws=XLSX.utils.aoa_to_sheet([d.head].concat(d.rows)),wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Relatório');XLSX.writeFile(wb,'SaborArte_relatorio_<%=h(tipo)%>_'+Date.now()+'.xlsx');}
function printReport(){var d=requireData();if(!d)return;var area=document.getElementById('printArea'),table=document.createElement('table');table.className='print-table';var tr=document.createElement('tr');d.head.forEach(function(x){var th=document.createElement('th');th.textContent=x;tr.appendChild(th);});var thead=document.createElement('thead');thead.appendChild(tr);table.appendChild(thead);var body=document.createElement('tbody');d.rows.forEach(function(row){var r=document.createElement('tr');row.forEach(function(x){var td=document.createElement('td');td.textContent=x;r.appendChild(td);});body.appendChild(r);});table.appendChild(body);area.replaceChildren();var title=document.createElement('div');title.className='print-title';title.textContent='Sabor & Arte — Relatórios';var meta=document.createElement('div');meta.className='print-meta';meta.textContent=new Date().toLocaleString('pt-BR')+' · '+d.rows.length+' registro(s)';area.append(title,meta,table);window.print();}
</script></body></html>
