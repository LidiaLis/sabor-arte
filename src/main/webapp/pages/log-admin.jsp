<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,java.util.Collections,java.net.URLEncoder" %>
<%@ page import="br.com.saborearte.model.Log" %>
<%!
private String h(Object value){if(value==null)return "";return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String label(Object value){if(value==null)return "";String s=String.valueOf(value).toLowerCase().replace('_',' ');return s.isEmpty()?s:Character.toUpperCase(s.charAt(0))+s.substring(1);}
%>
<%
request.setAttribute("currentPage","auditoria");
String ctx=request.getContextPath();
List<Log> logs=(List<Log>)request.getAttribute("logs");if(logs==null)logs=Collections.emptyList();
List<Log> exportLogs=(List<Log>)request.getAttribute("logsExportacao");if(exportLogs==null)exportLogs=Collections.emptyList();
String busca=request.getAttribute("filtroBusca")==null?"":String.valueOf(request.getAttribute("filtroBusca"));
String acao=request.getAttribute("filtroAcao")==null?"":String.valueOf(request.getAttribute("filtroAcao"));
String entidade=request.getAttribute("filtroEntidade")==null?"":String.valueOf(request.getAttribute("filtroEntidade"));
String periodo=request.getAttribute("filtroPeriodo")==null?"":String.valueOf(request.getAttribute("filtroPeriodo"));
int pageAtual=request.getAttribute("page") instanceof Number?((Number)request.getAttribute("page")).intValue():1;
int size=request.getAttribute("size") instanceof Number?((Number)request.getAttribute("size")).intValue():20;
int total=request.getAttribute("totalLogs") instanceof Number?((Number)request.getAttribute("totalLogs")).intValue():0;
int totalPages=request.getAttribute("totalPages") instanceof Number?((Number)request.getAttribute("totalPages")).intValue():1;
String query="&busca="+URLEncoder.encode(busca,"UTF-8")+"&acao="+URLEncoder.encode(acao,"UTF-8")+"&entidade="+URLEncoder.encode(entidade,"UTF-8")+"&periodo="+URLEncoder.encode(periodo,"UTF-8")+"&size="+size;
int inicio=total==0?0:(pageAtual-1)*size+1;int fim=Math.min(total,pageAtual*size);
%>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sabor &amp; Arte — Logs de Auditoria</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;family=Nunito:wght@700;800&amp;family=Playfair+Display:ital,wght@0,600;1,600&amp;display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{--moss:#4a5e3a;--cream:#f3efe6;--cream-dark:#e5dccb;--warm:#fffdf8;--text:#293022;--mid:#596052;--light:#899080;--gold:#c4a265;--danger:#a64b47;--blue:#47718f}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--text);font-family:'DM Sans',sans-serif}.main{margin-left:240px;min-height:100vh}.content{max-width:1260px;margin:auto;padding:32px}.top{display:flex;justify-content:space-between;align-items:flex-end;gap:15px;margin-bottom:26px}.title{font:600 30px 'Playfair Display',serif}.title em{color:var(--moss)}.subtitle{font-size:13px;color:var(--light);margin-top:5px}.export{display:flex;gap:7px}.btn{border:1px solid var(--cream-dark);background:var(--warm);padding:9px 13px;cursor:pointer;color:var(--mid);font:500 12px 'DM Sans',sans-serif}.btn:hover{border-color:var(--moss);color:var(--moss)}.layout{display:grid;grid-template-columns:240px 1fr;gap:18px;align-items:start}.panel,.result{background:var(--warm);border:1px solid var(--cream-dark)}.panel-head,.result-head{padding:15px 17px;border-bottom:1px solid var(--cream-dark);font-weight:600}.panel-body{padding:17px}.group{margin-bottom:15px}.group label{display:block;text-transform:uppercase;letter-spacing:.7px;color:var(--light);font-size:9px;font-weight:700;margin-bottom:6px}.input,.select{width:100%;padding:10px;border:1px solid var(--cream-dark);background:white;font:12px 'DM Sans',sans-serif;color:var(--mid)}.apply{width:100%;background:var(--moss);color:white;border-color:var(--moss);margin-top:4px}.clear{display:block;text-align:center;margin-top:9px;color:var(--light);font-size:11px}.result-head{display:flex;justify-content:space-between}.badge{background:var(--cream);padding:3px 8px;border-radius:10px;font-size:11px;color:var(--moss)}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:12px}th{background:var(--cream);padding:10px 13px;text-align:left;text-transform:uppercase;letter-spacing:.8px;font-size:9px;color:var(--light)}td{padding:12px 13px;border-top:1px solid var(--cream-dark);color:var(--mid);vertical-align:middle}.user{display:flex;gap:9px;align-items:center;white-space:nowrap}.avatar{width:34px;height:34px;border-radius:50%;background:#dfe5d6;display:flex;align-items:center;justify-content:center;color:var(--moss);font-weight:700;object-fit:cover}.role{font-size:9px;color:var(--light);text-transform:capitalize}.pill{display:inline-block;padding:5px 8px;border-radius:12px;background:#edf0e8;color:var(--moss);font-size:10px}.pill.login{background:#fff3dc;color:#9a651e}.pill.exclusao,.pill.remocao{background:#fae9e7;color:var(--danger)}.pill.edicao{background:#eaf2f7;color:var(--blue)}.footer{display:flex;justify-content:space-between;align-items:center;padding:13px 16px;border-top:1px solid var(--cream-dark);font-size:11px;color:var(--light)}.pagination{display:flex;gap:4px}.pagination a,.pagination span{min-width:31px;padding:7px;text-align:center;border:1px solid var(--cream-dark);text-decoration:none;color:var(--mid)}.pagination .active{background:var(--moss);color:white}.empty{text-align:center;padding:50px!important;color:var(--light)}.alert{padding:12px 15px;margin-bottom:16px;background:#fae9e7;color:var(--danger);border:1px solid #dfb8b5}#export-data{display:none}@media(max-width:900px){.main{margin-left:0}.layout{grid-template-columns:1fr}.content{padding:20px}.top{align-items:flex-start;flex-direction:column}}@media print{body>*:not(#printArea){display:none!important}#printArea{display:block!important}.print-table{font-size:10px}.print-table th,.print-table td{border:1px solid #bbb;padding:6px}.print-table th{background:#34452a;color:white}.print-title{font:600 20px Georgia,serif;margin-bottom:4px}.print-meta{font-size:10px;color:#666;margin-bottom:14px}}
</style></head><body>
<jsp:include page="/pages/includes/sidebar.jsp" />
<main class="main"><div class="content">
<div class="top"><div><div class="title">Logs de <em>Auditoria</em></div><div class="subtitle">Rastreamento das ações concluídas no sistema editorial</div></div><div class="export"><button class="btn" type="button" onclick="exportPDF()">⬇ PDF</button><button class="btn" type="button" onclick="exportExcel()">⬇ Excel</button><button class="btn" type="button" onclick="printReport()">🖨 Imprimir</button></div></div>
<%if(request.getAttribute("erro")!=null){%><div class="alert"><%=h(request.getAttribute("erro"))%></div><%}%>
<div class="layout"><aside class="panel"><div class="panel-head">Filtros</div><form class="panel-body" method="get" action="<%=ctx%>/LogController">
<div class="group"><label for="busca">Buscar usuário ou detalhe</label><input class="input" id="busca" name="busca" value="<%=h(busca)%>" placeholder="Nome, palavra-chave…"></div>
<div class="group"><label for="acao">Ação</label><select class="select" id="acao" name="acao"><option value="">Todas</option><%String[] acoes={"criacao","edicao","exclusao","login","aprovacao","rejeicao","publicacao","denuncia","resposta","alteracao"};for(String item:acoes){%><option value="<%=item%>" <%=item.equals(acao)?"selected":""%>><%=label(item)%></option><%}%></select></div>
<div class="group"><label for="entidade">Entidade</label><select class="select" id="entidade" name="entidade"><option value="">Todas</option><%String[] entidades={"Receita","Comentário","Usuário","Configuração","Sistema"};for(String item:entidades){%><option value="<%=item%>" <%=item.equals(entidade)?"selected":""%>><%=item%></option><%}%></select></div>
<div class="group"><label for="periodo">Período</label><select class="select" id="periodo" name="periodo"><option value="">Todos os períodos</option><option value="hoje" <%="hoje".equals(periodo)?"selected":""%>>Hoje</option><option value="7dias" <%="7dias".equals(periodo)?"selected":""%>>Últimos 7 dias</option><option value="mes" <%="mes".equals(periodo)?"selected":""%>>Último mês</option></select></div>
<button class="btn apply" type="submit">Aplicar filtros</button><a class="clear" href="<%=ctx%>/LogController">Limpar filtros</a></form></aside>
<section class="result"><div class="result-head"><span>Registro de Ações</span><span class="badge"><%=total%></span></div><div class="table-wrap"><table><thead><tr><th>Usuário</th><th>Ação</th><th>Entidade</th><th>Detalhe</th><th>Data / Hora</th></tr></thead><tbody>
<%if(logs.isEmpty()){%><tr><td class="empty" colspan="5">Nenhum registro encontrado para os filtros aplicados.</td></tr><%}else{for(Log log:logs){String nome=log.getNome_usuario()==null?"Usuário":log.getNome_usuario();String inicial=nome.isEmpty()?"?":nome.substring(0,1).toUpperCase();%>
<tr><td><div class="user"><%if(log.getFoto_usuario()!=null&&!log.getFoto_usuario().isBlank()){%><img class="avatar" src="<%=h(log.getFoto_usuario())%>" alt=""><%}else{%><span class="avatar"><%=h(inicial)%></span><%}%><div><div><%=h(nome)%></div><div class="role"><%=h(label(log.getTipo_usuario()))%></div></div></div></td><td><span class="pill <%=h(log.getAcao_log())%>"><%=h(label(log.getAcao_log()))%></span></td><td><%=h(log.getEntidade_log())%></td><td><%=h(log.getDetalhe_log())%></td><td><%=h(log.getData_log())%></td></tr><%}}%>
</tbody></table></div><div class="footer"><span>Exibindo <strong><%=inicio%>–<%=fim%></strong> de <strong><%=total%></strong></span><nav class="pagination"><%if(pageAtual>1){%><a href="<%=ctx%>/LogController?page=<%=pageAtual-1%><%=query%>">‹</a><%}for(int p=1;p<=totalPages;p++){if(p==pageAtual){%><span class="active"><%=p%></span><%}else{%><a href="<%=ctx%>/LogController?page=<%=p%><%=query%>"><%=p%></a><%}}if(pageAtual<totalPages){%><a href="<%=ctx%>/LogController?page=<%=pageAtual+1%><%=query%>">›</a><%}%></nav></div></section></div></div></main>
<table id="export-data"><tbody><%for(Log log:exportLogs){%><tr><td><%=h(log.getNome_usuario())%></td><td><%=h(label(log.getTipo_usuario()))%></td><td><%=h(label(log.getAcao_log()))%></td><td><%=h(log.getEntidade_log())%></td><td><%=h(log.getDetalhe_log())%></td><td><%=h(log.getData_log())%></td></tr><%}%></tbody></table><div id="printArea"></div>
<script>
function reportRows(){return Array.from(document.querySelectorAll('#export-data tbody tr')).map(function(row){return Array.from(row.cells).map(function(cell){return cell.textContent.trim();});});}
function ensureRows(){var rows=reportRows();if(!rows.length){window.alert('Nenhum registro encontrado para exportar.');return null;}return rows;}
var reportHead=['Usuário','Perfil','Ação','Entidade','Detalhe','Data / Hora'];
function exportPDF(){var rows=ensureRows();if(!rows)return;var jsPDF=window.jspdf.jsPDF,doc=new jsPDF({orientation:'landscape'});doc.setFontSize(16);doc.text('Sabor & Arte — Logs de Auditoria',14,16);doc.autoTable({head:[reportHead],body:rows,startY:23,theme:'grid',styles:{fontSize:8},headStyles:{fillColor:[52,69,42]}});doc.save('SaborArte_AuditLog_'+Date.now()+'.pdf');}
function exportExcel(){var rows=ensureRows();if(!rows)return;var sheet=XLSX.utils.aoa_to_sheet([reportHead].concat(rows)),book=XLSX.utils.book_new();XLSX.utils.book_append_sheet(book,sheet,'Logs de Auditoria');XLSX.writeFile(book,'SaborArte_AuditLog_'+Date.now()+'.xlsx');}
function printReport(){var rows=ensureRows();if(!rows)return;var area=document.getElementById('printArea'),table=document.createElement('table');table.className='print-table';var thead=document.createElement('thead'),hr=document.createElement('tr');reportHead.forEach(function(text){var th=document.createElement('th');th.textContent=text;hr.appendChild(th);});thead.appendChild(hr);table.appendChild(thead);var tbody=document.createElement('tbody');rows.forEach(function(values){var tr=document.createElement('tr');values.forEach(function(text){var td=document.createElement('td');td.textContent=text;tr.appendChild(td);});tbody.appendChild(tr);table.appendChild(tbody);area.replaceChildren();var title=document.createElement('div');title.className='print-title';title.textContent='Sabor & Arte — Logs de Auditoria';var meta=document.createElement('div');meta.className='print-meta';meta.textContent='Emitido em '+new Date().toLocaleString('pt-BR')+' · '+rows.length+' registro(s)';area.append(title,meta,table);window.print();}
</script></body></html>
